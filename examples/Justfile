# examples/Justfile — one target per runnable example.
#
# Forwarded from the top-level Justfile via `just examples <recipe>`.
# Recipes assume the parent repo's `just gen` has run so the
# examples/expected/* modules exist.
#
# Run individual examples:
#   just examples quickstart        # encode/decode round-trip
#   just examples grpc-loopback     # Greeter end-to-end, all 4 streaming flavors
#   just examples grpc-reflection-health  # server reflection + health services
#   just examples dynamic-schemas   # pb.parse on a schema stored in a Tarantool space
#   just examples tuple-range       # etcd-style Range response built from space tuples
#   just examples tuple-layouts     # one nested message as a map, an array, raw bytes
#   just examples json-http        # JSON-over-HTTP server (needs `tt rocks install http`)
#   just examples transcode         # google.api.http routing of the library service
#   just examples network-server    # pb.server: gRPC + HTTP/JSON on one port (needs http2)
#
# With PB_ENABLE_C=1 set (and `just build-c` run), the examples go
# through the C runtime.
#
# Run all non-interactive examples in sequence:
#   just examples all

set shell := ["bash", "-cu"]

# Run from the repo root so the LUA_PATH globs land correctly.
repo := justfile_directory() / ".."

# The tarantool-http2 rock for network-server: TARANTOOL_HTTP2_RUNTIME names
# the runtime/ directory of a checkout until the rock is published (see the
# top-level Justfile).
http2_runtime := env_var_or_default("TARANTOOL_HTTP2_RUNTIME", "")
http2_lua_path := if http2_runtime == "" { "" } else { http2_runtime + "/?.lua;" + http2_runtime + "/?/init.lua;" }

# Shared LUA_PATH: runtime/ + generated examples/expected/ (+ http2).
lua_path := "./runtime/?/init.lua;./runtime/?.lua;./examples/expected/?.lua;./examples/expected/?/init.lua;" + http2_lua_path + ";"

# Where `just build-c` puts pb.c_runtime; only loaded under PB_ENABLE_C=1.
lua_cpath := "./runtime/?.dylib;./runtime/?.so;;"

# Show available example recipes.
default:
    @just --list --justfile {{justfile()}}

# Run every non-interactive example in sequence.
all: quickstart grpc-loopback grpc-reflection-health dynamic-schemas tuple-range tuple-layouts transcode network-server-if-available

# Encode/decode a quickstart.User round-trip. Drives the first-message howto.
quickstart:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool -e ' \
        local qs = require("full.quickstart.quickstart_pb") \
        local pb = require("pb") \
        local b = qs.User_encode({id = 7, name = "Alice", role = qs.Role.ADMIN, emails = {"a@x", "b@x"}}) \
        print("encoded " .. #b .. " bytes") \
        local u = qs.User_decode(b) \
        print(u.id, u.name, u.role, u.emails[1], u.emails[2]) \
        print(qs.User_text(u)) \
    ' < /dev/null

# Greeter end-to-end via pb.grpc.loopback (all 4 streaming flavors).
grpc-loopback:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/grpc/client.lua

# Server reflection + health next to Greeter, driven by their generated clients.
grpc-reflection-health:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/grpc/reflection_health.lua < /dev/null

# pb.parse on schema text stored in a Tarantool space (cache + evolution).
dynamic-schemas:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/dynamic/load_from_space.lua

# Range response straight from space tuples (pb.tuple), and a put back.
tuple-range:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/tuple/kv_range.lua

# One nested message laid out as a map, an array and raw bytes (pb.tuple).
tuple-layouts:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/tuple/nested_layouts.lua

# google.api.http transcoding of the library service via pb.transcode.
transcode:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/http/transcode.lua

# pb.server on a free port: calls itself over HTTP/1.1 and HTTP/2, then stops.
# Needs the tarantool-http2 rock (TARANTOOL_HTTP2_RUNTIME, see above).
network-server:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/grpc/network_server.lua --self-check < /dev/null

# Interactive pb.server (gRPC, reflection, health, HTTP/JSON) until Ctrl-C.
network-server-listen port="8080":
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/grpc/network_server.lua {{port}}

# network-server, or a note when the http2 rock cannot be loaded (for `all`).
network-server-if-available:
    @cd {{repo}} && if LUA_PATH="{{lua_path}}" tarantool -e 'require("http2") os.exit(0)' < /dev/null > /dev/null 2>&1; then \
        just -f {{justfile()}} network-server; \
    else \
        echo "network-server: skipped, the http2 rock is not available (set TARANTOOL_HTTP2_RUNTIME)"; \
    fi

# Interactive JSON-over-HTTP server on :8080 (needs `tt rocks install http`).
json-http:
    @cd {{repo}} && LUA_PATH="{{lua_path}}" LUA_CPATH="{{lua_cpath}}" tarantool examples/http/json_api.lua

# Print the net.box transport stub (skeleton, not runnable on its own).
netbox-stub:
    @cd {{repo}} && cat examples/grpc/transport_netbox_stub.lua
